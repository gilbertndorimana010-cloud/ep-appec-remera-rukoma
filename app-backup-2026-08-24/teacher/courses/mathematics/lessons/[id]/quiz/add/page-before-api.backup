"use client";

import { useState } from "react";
import Link from "next/link";
import { useRouter } from "next/navigation";

type Question = {
  question: string;
  options: string[];
  correctAnswer: number;
};

export default function AddQuizPage({
  params,
}: {
  params: Promise<{ id: string }>;
}) {
  const router = useRouter();
  const [lessonId, setLessonId] = useState("");

  const [title, setTitle] = useState("");
  const [instructions, setInstructions] = useState("");
  const [timeLimit, setTimeLimit] = useState("");
  const [totalMarks, setTotalMarks] = useState("");

  const [questions, setQuestions] = useState<Question[]>([
    {
      question: "",
      options: ["", "", "", ""],
      correctAnswer: 0,
    },
  ]);

  useState(() => {
    params.then((value) => setLessonId(value.id));
  });

  function updateQuestion(
    questionIndex: number,
    value: string
  ) {
    setQuestions((current) =>
      current.map((question, index) =>
        index === questionIndex
          ? { ...question, question: value }
          : question
      )
    );
  }

  function updateOption(
    questionIndex: number,
    optionIndex: number,
    value: string
  ) {
    setQuestions((current) =>
      current.map((question, index) => {
        if (index !== questionIndex) return question;

        const options = [...question.options];
        options[optionIndex] = value;

        return {
          ...question,
          options,
        };
      })
    );
  }

  function updateCorrectAnswer(
    questionIndex: number,
    optionIndex: number
  ) {
    setQuestions((current) =>
      current.map((question, index) =>
        index === questionIndex
          ? { ...question, correctAnswer: optionIndex }
          : question
      )
    );
  }

  function addQuestion() {
    setQuestions((current) => [
      ...current,
      {
        question: "",
        options: ["", "", "", ""],
        correctAnswer: 0,
      },
    ]);
  }

  function removeQuestion(questionIndex: number) {
    setQuestions((current) =>
      current.filter((_, index) => index !== questionIndex)
    );
  }

  function saveQuiz() {
    if (!title.trim()) {
      alert("Please enter a quiz title.");
      return;
    }

    if (!timeLimit || Number(timeLimit) < 1) {
      alert("Please enter a valid time limit.");
      return;
    }

    if (!totalMarks || Number(totalMarks) < 1) {
      alert("Please enter valid total marks.");
      return;
    }

    for (let i = 0; i < questions.length; i++) {
      if (!questions[i].question.trim()) {
        alert(`Please enter question ${i + 1}.`);
        return;
      }

      for (let j = 0; j < questions[i].options.length; j++) {
        if (!questions[i].options[j].trim()) {
          alert(
            `Please complete all options for question ${i + 1}.`
          );
          return;
        }
      }
    }

    const quiz = {
      id: Date.now().toString(),
      lessonId,
      title,
      instructions,
      timeLimit: Number(timeLimit),
      totalMarks: Number(totalMarks),
      questions,
      createdAt: new Date().toISOString(),
    };

    localStorage.setItem(
      `ep-appec-quiz-${lessonId}`,
      JSON.stringify(quiz)
    );

    alert("Quiz saved successfully!");

    router.push(
      `/teacher/courses/mathematics/lessons/${lessonId}/quiz`
    );
  }

  if (!lessonId) {
    return null;
  }

  return (
    <main className="teacher-content-page">

      <header className="teacher-content-header">
        <div>

          <Link
            href={`/teacher/courses/mathematics/lessons/${lessonId}/quiz`}
            className="teacher-content-back"
          >
            ← Back to Quiz
          </Link>

          <span>QUIZ MANAGEMENT</span>

          <h1>Create Lesson Quiz</h1>

          <p>
            Create an assessment for Primary 6 students.
          </p>

        </div>

        <div className="teacher-content-icon">
          QUIZ
        </div>
      </header>

      <section className="teacher-content-card">

        <div className="teacher-content-card-top">

          <div>
            <span>QUIZ INFORMATION</span>

            <h2>
              New Lesson Quiz
            </h2>
          </div>

        </div>

        <form
          className="teacher-content-form"
          onSubmit={(event) => {
            event.preventDefault();
            saveQuiz();
          }}
        >

          <label>
            Quiz Title

            <input
              type="text"
              value={title}
              onChange={(event) =>
                setTitle(event.target.value)
              }
              placeholder="Enter quiz title"
            />
          </label>

          <label>
            Instructions

            <textarea
              rows={4}
              value={instructions}
              onChange={(event) =>
                setInstructions(event.target.value)
              }
              placeholder="Write instructions for students..."
            />
          </label>

          <label>
            Time Limit (minutes)

            <input
              type="number"
              min="1"
              value={timeLimit}
              onChange={(event) =>
                setTimeLimit(event.target.value)
              }
              placeholder="e.g. 30"
            />
          </label>

          <label>
            Total Marks

            <input
              type="number"
              min="1"
              value={totalMarks}
              onChange={(event) =>
                setTotalMarks(event.target.value)
              }
              placeholder="e.g. 20"
            />
          </label>

          <div
            style={{
              marginTop: "30px",
              marginBottom: "20px",
            }}
          >
            <h2>Questions</h2>
          </div>

          {questions.map((question, questionIndex) => (

            <div
              key={questionIndex}
              style={{
                border: "1px solid #ddd",
                borderRadius: "12px",
                padding: "20px",
                marginBottom: "20px",
              }}
            >

              <div
                style={{
                  display: "flex",
                  justifyContent: "space-between",
                  alignItems: "center",
                  marginBottom: "15px",
                }}
              >

                <h3>
                  Question {questionIndex + 1}
                </h3>

                {questions.length > 1 && (
                  <button
                    type="button"
                    className="teacher-content-secondary"
                    onClick={() =>
                      removeQuestion(questionIndex)
                    }
                  >
                    Remove
                  </button>
                )}

              </div>

              <label>
                Question

                <textarea
                  rows={3}
                  value={question.question}
                  onChange={(event) =>
                    updateQuestion(
                      questionIndex,
                      event.target.value
                    )
                  }
                  placeholder="Enter the question..."
                />
              </label>

              <div style={{ marginTop: "15px" }}>

                <strong>
                  Answer Options
                </strong>

              </div>

              {question.options.map(
                (option, optionIndex) => (

                  <label key={optionIndex}>

                    Option {String.fromCharCode(65 + optionIndex)}

                    <input
                      type="text"
                      value={option}
                      onChange={(event) =>
                        updateOption(
                          questionIndex,
                          optionIndex,
                          event.target.value
                        )
                      }
                      placeholder={`Enter option ${String.fromCharCode(
                        65 + optionIndex
                      )}`}
                    />

                    <span
                      style={{
                        display: "block",
                        marginTop: "5px",
                      }}
                    >
                      <input
                        type="radio"
                        name={`correct-${questionIndex}`}
                        checked={
                          question.correctAnswer ===
                          optionIndex
                        }
                        onChange={() =>
                          updateCorrectAnswer(
                            questionIndex,
                            optionIndex
                          )
                        }
                      />{" "}
                      Correct answer
                    </span>

                  </label>

                )
              )}

            </div>

          ))}

          <button
            type="button"
            className="teacher-content-secondary"
            onClick={addQuestion}
          >
            + Add Another Question
          </button>

          <div className="teacher-content-form-actions">

            <Link
              href={`/teacher/courses/mathematics/lessons/${lessonId}/quiz`}
              className="teacher-content-secondary"
            >
              Cancel
            </Link>

            <button
              type="submit"
              className="teacher-content-primary"
            >
              Save Quiz
            </button>

          </div>

        </form>

      </section>

      <footer className="teacher-content-footer">

        <strong>
          EP APPEC Remera Rukoma
        </strong>

        <span>
          Teacher Portal · © 2026
        </span>

      </footer>

    </main>
  );
}
